# ============================================================================
# Dockerignore for Boxed Sneakers Cloud Run Deployment
# ============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (will be generated in container)
dist
build

# Testing
coverage
.nyc_output

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# CI/CD
.github

# Documentation
*.md
!README.md

# Logs
logs
*.log

# Firebase
.firebaserc
firebase-debug.log
.firebase/

# Playwright
test-results/
playwright-report/

# Misc
.cache
.temp
.tmp

# Scripts with sensitive data
scripts/node_modules/
scripts/serviceAccountKey.json

# React migration starter (not used)
react-migration-starter/

# Monitoring (not needed in container)
monitoring/

# Coverage reports
coverage/

# Local development files
*.local
