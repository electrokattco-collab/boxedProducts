# BoxedSneakers Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# DATA CONFIGURATION
# ============================================================================

# Path to local product data file (fallback when Firebase unavailable)
DATA_SOURCE_PATH=products.json

# ============================================================================
# FIREBASE CONFIGURATION (Optional - only if overriding hardcoded values)
# ============================================================================
# These are currently hardcoded in src/services/firebaseConfig.js
# Set these only if you need to override for different environments

# VITE_FIREBASE_API_KEY=your_api_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
# VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Node environment (development | production)
NODE_ENV=production

# Port for local development server (if applicable)
# PORT=3000

# ============================================================================
# SECURITY HEADERS (Optional)
# ============================================================================

# CSP Report URI for tracking policy violations
# CSP_REPORT_URI=https://your-report-endpoint.com/csp-report

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================

# Enable/disable customer authentication requirement
# ENFORCE_CUSTOMER_AUTH=false

# Enable/disable analytics
# ENABLE_ANALYTICS=true
